# Copy this file to .env for local development (.env is git-ignored).
#
# DATABASE_URL is used by the running app (src/lib/prisma.ts) and by Prisma
# CLI commands when DIRECT_URL is not set.
#
# Local development (Docker Compose, see docker-compose.yml):
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/dashboard_db?schema=public"

# DIRECT_URL is optional and only matters in production. Managed Postgres
# providers (e.g. Neon, Supabase) offer both a *pooled* connection string
# (for the app's many short-lived serverless connections) and a *direct*
# unpooled one (best for running schema migrations). If your provider gives
# you both, set DATABASE_URL to the pooled string and DIRECT_URL to the
# direct string. If it only gives you one connection string, omit DIRECT_URL
# and Prisma will fall back to DATABASE_URL for migrations too.
# DIRECT_URL="postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require"
